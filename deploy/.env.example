# deploy/.env: copy this file to deploy/.env, fill it in, then `chmod 600 deploy/.env`.
# Never commit deploy/.env (it is in .gitignore).
#
# These values are read by the configs through ENV: references, e.g.
# `host: "ENV:CAMERA_IP"` in deploy/zrelay.yaml. Secrets that are files
# (master key, S3 secret keys, API token hash) live in deploy/secrets/ instead;
# see README.md "Where your settings go".
#
# zrelay receives this whole file. zview-server receives only S3_ENDPOINT and
# S3_RO_ACCESS_KEY (deploy/compose.yaml), so camera and relay credentials never
# reach the viewer.

# --- Camera (deploy/zrelay.yaml, cameras[0]) --------------------------------
# The camera's IP on your LAN or tailnet, and the "Camera Account" you create in
# the Tapo app (Advanced Settings > Camera Account), not your TP-Link login.
CAMERA_IP=192.168.1.50
CAMERA_USERNAME=
CAMERA_PASSWORD=
# More cameras: add a block per camera in zrelay.yaml with its own variable
# names, e.g. host: "ENV:GARAGE_CAMERA_IP", and add those variables here.

# --- S3 / MinIO --------------------------------------------------------------
# MinIO's S3 API URL as the Mac mini reaches it (over Tailscale). Bucket,
# region and root prefix are in zrelay.yaml and zview.yaml (storage.s3).
S3_ENDPOINT=https://nas.example-tailnet.ts.net:9000
# Access key of the MinIO user "zrelay" (write, no archive delete); its secret
# key goes in deploy/secrets/s3_secret_key.
S3_ACCESS_KEY=zrelay
# Access key of the read-only MinIO user "zview"; its secret key goes in
# deploy/secrets/s3_ro_secret_key.
S3_RO_ACCESS_KEY=zview

# --- RTSP restream (rtsp://<user>:<pass>@<tailscale-ip>:8554/<camera-id>) -----
# Credentials VLC and IPTV players use. Pick your own; long and random is best.
RESTREAM_USER=viewer
RESTREAM_PASS=

# TAILSCALE_IP is not set here: deploy/deploy.sh reads it from `tailscale ip -4`.
