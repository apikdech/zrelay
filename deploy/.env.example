# deploy/.env
#
# How to use this file:
#   1. Copy this file to deploy/.env.
#   2. Write your values in deploy/.env.
#   3. Run `chmod 600 deploy/.env`.
# Do not commit deploy/.env. Git ignores it.
#
# The configuration files read these values through ENV: references. For
# example, `host: "ENV:CAMERA_IP"` in deploy/zrelay.yaml reads CAMERA_IP.
# Secrets that are files (master key, S3 secret keys, API token hash) are in
# deploy/secrets/, not here. See "Where to put your settings" in README.md.
#
# zrelay gets all of this file. zview-server gets only S3_ENDPOINT and
# S3_RO_ACCESS_KEY (see deploy/compose.yaml). Thus the viewer never gets the
# camera credentials or the relay credentials.

# --- Camera (deploy/zrelay.yaml, cameras[0]) ---------------------------------
# The IP address of the camera on your LAN or tailnet.
# Use the "Camera Account" from the Tapo app (Advanced Settings >
# Camera Account). Do not use your TP-Link login.
CAMERA_IP=192.168.1.50
CAMERA_USERNAME=
CAMERA_PASSWORD=
# For more cameras: add one block for each camera in zrelay.yaml. Give each
# camera its own names, for example host: "ENV:GARAGE_CAMERA_IP". Then add
# these names here.

# --- S3 / MinIO --------------------------------------------------------------
# The URL of the MinIO S3 API, as the Mac mini connects to it (through
# Tailscale). The bucket, the region, and the root prefix are in zrelay.yaml
# and zview.yaml (storage.s3).
S3_ENDPOINT=https://nas.example-tailnet.ts.net:9000
# The access key of the MinIO user "zrelay". This user can write, but it
# cannot delete archive objects. Put its secret key in
# deploy/secrets/s3_secret_key.
S3_ACCESS_KEY=zrelay
# The access key of the read-only MinIO user "zview". Put its secret key in
# deploy/secrets/s3_ro_secret_key.
S3_RO_ACCESS_KEY=zview

# --- RTSP restream (rtsp://<user>:<pass>@<tailscale-ip>:8554/<camera-id>) -----
# VLC and IPTV players use these credentials. Select your own values. Use a
# long random password.
RESTREAM_USER=viewer
RESTREAM_PASS=

# Do not set TAILSCALE_IP here. deploy/deploy.sh gets it from `tailscale ip -4`.
