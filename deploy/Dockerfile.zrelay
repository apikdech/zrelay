# zrelay container image (design §8.3). Build from the repository root:
#   docker build -f deploy/Dockerfile.zrelay .
# The runtime image is scratch: the static binary and the CA bundle only.
FROM golang:1.27-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
# VERSION is stamped into main.version (sidecar recorder.version and the
# status object); deploy.sh sets it from the repository's release description.
ARG VERSION=dev
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w -X main.version=${VERSION}" -o /out/zrelay ./cmd/zrelay

FROM scratch
COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=build /out/zrelay /zrelay
USER 65534:65534
ENTRYPOINT ["/zrelay","run","--config=/etc/zrelay/zrelay.yaml"]
